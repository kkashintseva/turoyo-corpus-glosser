# Writable Turoyo project state. Leave unset for local use in the checkout.
# The MAALULA_* variable names are retained internally for compatibility with
# the inherited editor code; they do not enable the Maalula language profile.
MAALULA_STATE_DIR=

# Optional HTTP Basic login for a network deployment. Both must be set together.
MAALULA_USER=
MAALULA_PASSWORD=
